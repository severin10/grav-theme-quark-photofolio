{#
    Standalone page for a page whose filename is form.md (matches Grav's
    own documented forms example). Renders whatever form: is defined in
    that page's frontmatter — nothing page-specific lives in the theme.
#}
{% extends 'partials/base.html.twig' %}

{% block content %}
<div class="container intro-container">
    <h1 class="page-title">{{ page.title }}</h1>
    {% if page.content %}<div class="intro-content">{{ page.content|raw }}</div>{% endif %}
</div>
<section class="section">
    <div class="container contact-page-container">
        {% if form %}
            {% include 'forms/form.html.twig' %}
        {% endif %}
    </div>
</section>
{% endblock %}
