<nav class="section-nav" aria-label="{{ 'THEME_QUARK_PHOTOFOLIO.ARIA.PRIMARY_NAV'|t|e('html_attr') }}">
    <ul>
        {% for child in page.children %}
            {% set has_photos = child.header.photos.items|default([])|length %}
            <li><a href="{{ has_photos ? '#' ~ child.slug : child.url }}">{{ child.title }}</a></li>
        {% endfor %}
    </ul>
</nav>
