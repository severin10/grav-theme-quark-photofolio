{#
    Support is a theme-owned slot, not theme-owned content: the heading
    stays here so the section always has something to show, but the actual
    body is left to whatever a site or plugin chooses to put in
    partials/support.html.twig. It doesn't exist in the theme itself.

    Contact isn't handled this way: add a page using templates/form.html.twig
    as a model (see the theme README) and it shows up in the nav on its own,
    linking to its own URL — Grav's documented way to run a form.
#}
<section id="support" class="section placeholder-section">
    <div class="container">
        <h2>{{ 'THEME_QUARK_PHOTOFOLIO.SECTIONS.SUPPORT_TITLE'|t }}</h2>
        {% include 'partials/support.html.twig' ignore missing %}
    </div>
</section>

<footer id="footer" class="section section-tight">
    <div class="container">
        <p class="footer-credit">
            &copy; {{ "now"|date("Y") }} {{ site.title }} —
            <a href="https://getgrav.org">Grav</a> theme based on
            <a href="https://github.com/getgrav/grav-theme-quark2">Quark 2</a>.
        </p>
    </div>
</footer>
