{#
    Contact and Support are theme-owned slots, not theme-owned content: the
    heading stays here so the section always has something to show and the
    nav anchor always has somewhere to land, but the actual body is left to
    whatever a site or plugin (e.g. a separate contact-form plugin) chooses
    to put in these partials. Neither exists in the theme itself.
#}
<section id="contact" class="section placeholder-section">
    <div class="container">
        <h2>{{ 'THEME_QUARK_PHOTOFOLIO.SECTIONS.CONTACT_TITLE'|t }}</h2>
        {% include 'partials/contact.html.twig' ignore missing %}
    </div>
</section>

<section id="support" class="section placeholder-section">
    <div class="container">
        <h2>{{ 'THEME_QUARK_PHOTOFOLIO.SECTIONS.SUPPORT_TITLE'|t }}</h2>
        {% include 'partials/support.html.twig' ignore missing %}
    </div>
</section>

<footer id="footer" class="section section-tight">
    <div class="container">
        <p class="footer-credit">
            &copy; {{ "now"|date("Y") }} {{ site.title }} —
            <a href="https://getgrav.org">Grav</a> theme based on
            <a href="https://github.com/getgrav/grav-theme-quark2">Quark 2</a>.
        </p>
    </div>
</footer>
